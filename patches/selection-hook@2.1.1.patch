@@ -21,8 +21,21 @@ NSRunningApplication *GetFrontApp()
     // the process started. distantPast makes it a non-blocking single pass.
     [[NSRunLoop currentRunLoop] runMode:NSDefaultRunLoopMode beforeDate:[NSDate distantPast]];
 
-    NSWorkspace *workspace = [NSWorkspace sharedWorkspace];
-    return workspace.frontmostApplication;
+    // A nonactivating panel can own keyboard focus while another app remains frontmost.
+    AXUIElementRef system = AXUIElementCreateSystemWide();
+    CFTypeRef focused = nullptr;
+    AXError error = AXUIElementCopyAttributeValue(system, kAXFocusedApplicationAttribute, &focused);
+    CFRelease(system);
+    if (error == kAXErrorSuccess && focused)
+    {
+        pid_t pid = 0;
+        AXUIElementGetPid((AXUIElementRef)focused, &pid);
+        CFRelease(focused);
+        NSRunningApplication *application = [NSRunningApplication runningApplicationWithProcessIdentifier:pid];
+        if (application)
+            return application;
+    }
+    return NSWorkspace.sharedWorkspace.frontmostApplication;
 }
 
